<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Photo row: primary + up to 2 thumbnails -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_candidate_photo_primary"
                android:layout_width="96dp"
                android:layout_height="112dp"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_candidate_photo_placeholder"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.FieldIntel.Small"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp" />

            <LinearLayout
                android:id="@+id/photo_thumbnails_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_photo_thumb_2"
                    android:layout_width="48dp"
                    android:layout_height="52dp"
                    android:layout_marginBottom="6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_candidate_photo_placeholder"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.FieldIntel.Small"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_photo_thumb_3"
                    android:layout_width="48dp"
                    android:layout_height="52dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_candidate_photo_placeholder"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.FieldIntel.Small"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_candidate_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SixDegrees.TitleMedium"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="John Smith" />

                <TextView
                    android:id="@+id/tv_candidate_age_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.SixDegrees.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Age 42 · Austin, TX" />

                <TextView
                    android:id="@+id/tv_candidate_employer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.SixDegrees.LabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="Software engineer" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_match_score"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="11sp"
                    app:chipMinHeight="28dp"
                    tools:text="72% match" />
            </LinearLayout>
        </LinearLayout>

        <!-- Social profile links -->
        <LinearLayout
            android:id="@+id/social_icons_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_social_linkedin"
                style="@style/Widget.SixDegrees.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/social_linkedin"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_social_facebook"
                style="@style/Widget.SixDegrees.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/social_facebook"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_social_instagram"
                style="@style/Widget.SixDegrees.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/social_instagram"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_thats_them"
            style="@style/Widget.SixDegrees.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:text="@string/candidate_thats_them" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
