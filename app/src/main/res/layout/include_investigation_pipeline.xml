<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/investigation_pipeline"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding_horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="8dp"
    android:background="?attr/colorSurfaceContainer">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pipeline_label"
        android:textAppearance="@style/TextAppearance.SixDegrees.LabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:letterSpacing="0.12"
        android:textAllCaps="true"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/pipeline_step_intake"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/pipeline_dot_intake"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                android:background="?attr/colorPrimary" />

            <TextView
                android:id="@+id/pipeline_label_intake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/pipeline_step_intake"
                android:textSize="9sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="?attr/colorPrimary"
                android:gravity="center" />
        </LinearLayout>

        <View
            android:id="@+id/pipeline_connector_1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="0.6"
            android:background="?attr/colorOutlineVariant" />

        <LinearLayout
            android:id="@+id/pipeline_step_collect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/pipeline_dot_collect"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="2"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:background="?attr/colorSurfaceVariant" />

            <TextView
                android:id="@+id/pipeline_label_collect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/pipeline_step_collect"
                android:textSize="9sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center" />
        </LinearLayout>

        <View
            android:id="@+id/pipeline_connector_2"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="0.6"
            android:background="?attr/colorOutlineVariant" />

        <LinearLayout
            android:id="@+id/pipeline_step_resolve"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/pipeline_dot_resolve"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="3"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:background="?attr/colorSurfaceVariant" />

            <TextView
                android:id="@+id/pipeline_label_resolve"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/pipeline_step_resolve"
                android:textSize="9sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center" />
        </LinearLayout>

        <View
            android:id="@+id/pipeline_connector_3"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="0.6"
            android:background="?attr/colorOutlineVariant" />

        <LinearLayout
            android:id="@+id/pipeline_step_dossier"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/pipeline_dot_dossier"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="4"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:background="?attr/colorSurfaceVariant" />

            <TextView
                android:id="@+id/pipeline_label_dossier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/pipeline_step_dossier"
                android:textSize="9sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
