<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:colorBackground">

    <!-- TOOLBAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0A0A0A">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/results_toolbar"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                app:title="◈  CASE FILE"
                app:titleTextColor="?attr/colorPrimary"
                app:titleTextAppearance="@style/TextAppearance.SixDegrees.DossierTitle"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="?attr/colorPrimary"
                app:elevation="0dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_export"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="end"
                    android:layout_marginEnd="8dp"
                    android:text="EXPORT"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1dp"
                    app:cornerRadius="2dp" />
            </com.google.android.material.appbar.MaterialToolbar>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/accent_red" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loading_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="40dp"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ NO FILE ]"
            android:textColor="?attr/colorPrimary"
            android:alpha="0.3"
            android:textSize="28sp"
            android:letterSpacing="0.2"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NO DOSSIER LOADED"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.15"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run a search to generate an intelligence report"
            android:textColor="?attr/colorControlNormal"
            android:textSize="12sp"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/results_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- SUBJECT CARD -->
        <LinearLayout
            android:id="@+id/person_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="0dp"
            android:paddingVertical="0dp"
            android:gravity="center_vertical"
            android:background="?attr/colorSurface">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@color/accent_red"
                android:minHeight="80dp" />

            <ImageView
                android:id="@+id/profile_image"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person_placeholder"
                android:background="@drawable/bg_score_circle" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLASSIFIED SUBJECT"
                    android:textColor="@color/accent_red"
                    android:textSize="7sp"
                    android:letterSpacing="0.25"
                    android:textAllCaps="true"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:id="@+id/full_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textIsSelectable="true" />

                <TextView
                    android:id="@+id/job_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textIsSelectable="true" />

                <TextView
                    android:id="@+id/location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorControlNormal"
                    android:textSize="11sp"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textIsSelectable="true" />
            </LinearLayout>

            <!-- THREAT SCORE -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:minWidth="56dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THREAT"
                    android:textColor="?attr/colorControlNormal"
                    android:textSize="7sp"
                    android:letterSpacing="0.2"
                    android:textAllCaps="true"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tv_score_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textIsSelectable="true" />

                <TextView
                    android:id="@+id/tv_sources_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorControlNormal"
                    android:textSize="8sp"
                    android:letterSpacing="0.05"
                    android:gravity="center"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- THREAT BAR -->
        <LinearLayout
            android:id="@+id/shady_score_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical"
            android:background="?attr/colorSurface">

            <View
                android:id="@+id/score_accent_bar"
                android:layout_width="3dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:background="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THREAT ASSESSMENT"
                    android:textColor="?attr/colorControlNormal"
                    android:textSize="8sp"
                    android:letterSpacing="0.18"
                    android:textAllCaps="true"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tv_score_verdict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[ ANALYZING ]"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:ellipsize="none"
                    android:textIsSelectable="true" />

                <TextView
                    android:id="@+id/tv_score_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorControlNormal"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"
                    android:textIsSelectable="true" />
            </LinearLayout>

            <!-- MINI STATS -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone"
                android:id="@+id/stats_container">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/tv_stat_sources"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textIsSelectable="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SOURCES"
                        android:textColor="?attr/colorControlNormal"
                        android:textSize="7sp"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/tv_stat_confidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textIsSelectable="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONFIDENCE"
                        android:textColor="?attr/colorControlNormal"
                        android:textSize="7sp"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/tv_stat_data_points"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textIsSelectable="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DATA PTS"
                        android:textColor="?attr/colorControlNormal"
                        android:textSize="7sp"
                        android:letterSpacing="0.1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="?attr/colorPrimary"
            android:alpha="0.3" />

        <!-- TABS -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="?attr/colorSurface"
            app:tabMode="scrollable"
            app:tabGravity="start"
            app:tabIndicatorColor="?attr/colorPrimary"
            app:tabSelectedTextColor="?attr/colorPrimary"
            app:tabTextColor="?attr/colorControlNormal"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="2dp"
            app:tabTextAppearance="@style/TextAppearance.SixDegrees.TabText"
            app:tabPaddingStart="4dp"
            app:tabPaddingEnd="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <!-- VIEW PAGER -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>
</LinearLayout>
