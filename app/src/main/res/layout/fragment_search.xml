<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="100dp">

        <include
            android:id="@+id/pipeline_include"
            layout="@layout/include_investigation_pipeline" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_intake_title"
                android:textAppearance="@style/TextAppearance.SixDegrees.HeadlineMedium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/search_intake_subtitle"
                android:textAppearance="@style/TextAppearance.SixDegrees.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Subject type selector — larger pill chips with clear visual state -->
        <HorizontalScrollView
            android:id="@+id/type_chip_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_type_person"
                    style="@style/Widget.SixDegrees.Chip.TypeSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/intake_type_person" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_type_company"
                    style="@style/Widget.SixDegrees.Chip.TypeSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intake_type_company" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_type_vehicle"
                    style="@style/Widget.SixDegrees.Chip.TypeSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intake_type_vehicle" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_type_domain"
                    style="@style/Widget.SixDegrees.Chip.TypeSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intake_type_domain" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_type_phone"
                    style="@style/Widget.SixDegrees.Chip.TypeSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intake_type_phone" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_type_email"
                    style="@style/Widget.SixDegrees.Chip.TypeSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intake_type_email" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_type_username"
                    style="@style/Widget.SixDegrees.Chip.TypeSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intake_type_username" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_type_photo"
                    style="@style/Widget.SixDegrees.Chip.TypeSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intake_type_photo" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <!-- Subject detail fields -->
        <LinearLayout
            android:id="@+id/field_cards_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal">

            <!-- Person: freeform paste -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_freeform"
                style="@style/Widget.SixDegrees.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/field_gap"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/intake_freeform_label"
                        android:textAppearance="@style/TextAppearance.SixDegrees.TitleMedium" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_freeform"
                        style="@style/Widget.SixDegrees.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_freeform"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/intake_freeform_hint"
                            android:inputType="textCapSentences|textMultiLine"
                            android:minLines="2" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/intake_freeform_helper"
                        android:textAppearance="@style/TextAppearance.SixDegrees.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Company -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_company"
                style="@style/Widget.SixDegrees.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/field_gap"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/intake_company_label"
                        android:textAppearance="@style/TextAppearance.SixDegrees.TitleMedium" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_company"
                        style="@style/Widget.SixDegrees.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/intake_company_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_company"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_company_domain"
                        style="@style/Widget.SixDegrees.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/intake_company_domain_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_company_domain"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Vehicle -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_vehicle"
                style="@style/Widget.SixDegrees.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/field_gap"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/intake_vehicle_label"
                        android:textAppearance="@style/TextAppearance.SixDegrees.TitleMedium" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_vehicle_vin"
                        style="@style/Widget.SixDegrees.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_vehicle_vin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/intake_vehicle_hint"
                            android:inputType="textCapCharacters"
                            android:maxLength="17" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Domain / IP -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_domain"
                style="@style/Widget.SixDegrees.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/field_gap"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/intake_domain_label"
                        android:textAppearance="@style/TextAppearance.SixDegrees.TitleMedium" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_domain_ip"
                        style="@style/Widget.SixDegrees.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_domain_ip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/intake_domain_hint"
                            android:inputType="textUri" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Phone -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_phone"
                style="@style/Widget.SixDegrees.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/field_gap"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/intake_phone_label"
                        android:textAppearance="@style/TextAppearance.SixDegrees.TitleMedium" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_phone"
                        style="@style/Widget.SixDegrees.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_phone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/intake_phone_hint"
                            android:imeOptions="actionNext"
                            android:inputType="phone"
                            android:minHeight="56dp"
                            android:textAppearance="@style/TextAppearance.SixDegrees.TitleLarge"
                            android:textColor="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/intake_phone_helper"
                        android:textAppearance="@style/TextAppearance.SixDegrees.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- IDENTITY section header -->
            <TextView
                android:id="@+id/tv_person_details_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="@string/intake_section_identity"
                android:textAppearance="@style/TextAppearance.SixDegrees.SectionHeader" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_name"
                style="@style/Widget.SixDegrees.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/field_gap"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/intake_name_label"
                        android:textAppearance="@style/TextAppearance.SixDegrees.TitleMedium" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_first_name"
                            style="@style/Widget.SixDegrees.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:hint="@string/intake_first_name_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_first_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords|textPersonName" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_last_name"
                            style="@style/Widget.SixDegrees.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/intake_last_name_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_last_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords|textPersonName" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_photo"
                style="@style/Widget.SixDegrees.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/field_gap"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/intake_photo_label"
                        android:textAppearance="@style/TextAppearance.SixDegrees.TitleMedium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/intake_photo_helper"
                        android:textAppearance="@style/TextAppearance.SixDegrees.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_camera"
                            style="@style/Widget.SixDegrees.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="@string/camera_capture"
                            app:icon="@drawable/ic_camera_black_24dp"
                            app:iconGravity="textStart" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_gallery"
                            style="@style/Widget.SixDegrees.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/gallery_pick"
                            app:icon="@drawable/ic_gallery_black_24dp"
                            app:iconGravity="textStart" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_image_attached"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAppearance="@style/TextAppearance.SixDegrees.BodyMedium"
                        android:textColor="?attr/colorPrimary"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- DIGITAL section header -->
            <TextView
                android:id="@+id/tv_section_digital"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:text="@string/intake_section_digital"
                android:textAppearance="@style/TextAppearance.SixDegrees.SectionHeader"
                android:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_email"
                style="@style/Widget.SixDegrees.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/field_gap"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_email"
                        style="@style/Widget.SixDegrees.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/intake_email_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_username"
                style="@style/Widget.SixDegrees.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/field_gap"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_username"
                        style="@style/Widget.SixDegrees.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/intake_username_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_username"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- LOCATION section header -->
            <TextView
                android:id="@+id/tv_section_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:text="@string/intake_section_location"
                android:textAppearance="@style/TextAppearance.SixDegrees.SectionHeader"
                android:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_location"
                style="@style/Widget.SixDegrees.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/field_gap"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/intake_location_label"
                        android:textAppearance="@style/TextAppearance.SixDegrees.TitleMedium" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_address"
                        style="@style/Widget.SixDegrees.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/intake_address_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPostalAddress|textCapWords" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_city"
                            style="@style/Widget.SixDegrees.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="2"
                            android:hint="@string/intake_city_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_city"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_state"
                            style="@style/Widget.SixDegrees.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/intake_state_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_state"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapCharacters"
                                android:maxLength="2" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Intent picker (OSINT Pro) -->
        <LinearLayout
            android:id="@+id/intent_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/intake_intent_label"
                android:textAppearance="@style/TextAppearance.SixDegrees.TitleMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/intake_intent_helper"
                android:textAppearance="@style/TextAppearance.SixDegrees.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_intent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_intent_first_date"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intake_intent_first_date" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_intent_meeting"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intake_intent_meeting" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_intent_verify"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intake_intent_verify" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_intent_fraud"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intake_intent_fraud" />

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>

        <!-- Source counter chip -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
            android:layout_marginTop="@dimen/section_gap"
            app:cardBackgroundColor="?attr/colorSecondaryContainer"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tv_query_counter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text="@string/intake_sources_default"
                android:textAppearance="@style/TextAppearance.SixDegrees.LabelMedium"
                android:textColor="?attr/colorOnSecondaryContainer" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding_horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/search_button"
                style="@style/Widget.SixDegrees.Button.Filled"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/intake_start_investigation"
                app:icon="@drawable/ic_search"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_fields"
                style="@style/Widget.SixDegrees.Button.Outlined"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/intake_clear_fields"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="X"
                android:textSize="18sp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_web_hub"
            style="@style/Widget.SixDegrees.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
            android:layout_marginTop="12dp"
            android:text="@string/intake_web_hub"
            app:icon="@drawable/ic_web_hub"
            app:iconGravity="textStart" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- Recent investigations -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/recent_searches_title"
                android:textAppearance="@style/TextAppearance.SixDegrees.LabelMedium" />

            <TextView
                android:id="@+id/no_recent_searches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="20dp"
                android:text="@string/no_recent_searches"
                android:textAppearance="@style/TextAppearance.SixDegrees.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recent_searches_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
