<?xml version="1.0" encoding="utf-8"?>
<!-- Single white-brick tile unit (72×32) — tiled via bg_plug_brick.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/plug_grout" />
            <size
                android:width="72dp"
                android:height="32dp" />
        </shape>
    </item>
    <!-- Top row: two half-width bricks -->
    <item
        android:bottom="17dp"
        android:left="2dp"
        android:right="38dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/plug_brick" />
        </shape>
    </item>
    <item
        android:bottom="17dp"
        android:left="38dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/plug_brick_alt" />
        </shape>
    </item>
    <!-- Bottom row: offset running bond -->
    <item
        android:bottom="2dp"
        android:left="20dp"
        android:right="38dp"
        android:top="17dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/plug_brick_alt" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="56dp"
        android:top="17dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/plug_brick" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="56dp"
        android:right="2dp"
        android:top="17dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/plug_brick" />
        </shape>
    </item>
</layer-list>
