<?xml version="1.0" encoding="utf-8"?>
<!-- Colombian flag proportions: 50% yellow, 25% blue, 25% red -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/patrino_yellow" />
        </shape>
    </item>
    <item android:top="12dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/patrino_blue" />
        </shape>
    </item>
    <item android:top="18dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/patrino_red" />
        </shape>
    </item>
</layer-list>
