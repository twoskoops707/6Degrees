    <!-- Wizard tips -->
    <string name="tip_1">For person investigations, include city and state — narrows 50M+ records to a handful of real matches</string>
    <string name="tip_2">Enable Termux external-app permission before tapping any install command (Step 1 above)</string>
    <string name="tip_3">Sherlock and Maigret run in Termux background — check the Termux app directly for username sweep results</string>
    <string name="tip_4">The HIBP key unlocks data-breach history; the Shodan key adds open-port and device intel to IP/domain reports</string>
    <string name="tip_5">Round 1 returns candidate cards — pick the closest match to trigger a full deep-dive intelligence report</string>
    <string name="tip_6">If a report looks thin, add employer name, school, or approximate age to the form and re-run</string>
    <string name="tip_7">Email and username investigations work without any API keys — all free sources are queried automatically</string>
    <string name="tip_8">Tap any phone number, email, or URL in a report to dial, open mail, or launch the browser directly</string>

